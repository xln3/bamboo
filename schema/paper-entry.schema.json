{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BAMBOO Paper Entry",
  "description": "Metadata for a single paper in the BAMBOO benchmark",
  "type": "object",
  "required": ["paper_id", "title", "venue", "year", "code_url", "code_commit"],
  "properties": {
    "paper_id": {
      "type": "string",
      "pattern": "^bamboo-\\d{5}$",
      "description": "Unique identifier (bamboo-00001 onwards, no upper limit)"
    },
    "arxiv_id": {
      "type": "string",
      "description": "arXiv identifier (e.g., 2501.12345)"
    },
    "title": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "venue": {
      "type": "string",
      "enum": ["NeurIPS", "ICML", "ICLR", "CVPR", "ICCV", "ACL", "EMNLP", "AAAI", "ICRA"]
    },
    "year": {
      "type": "integer",
      "const": 2025
    },
    "venue_track": {
      "type": "string",
      "enum": ["main", "workshop", "findings", "demo", "datasets-benchmarks"],
      "default": "main"
    },
    "abstract": {
      "type": "string",
      "description": "Paper abstract text"
    },
    "paper_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to paper landing page"
    },
    "pdf_url": {
      "type": "string",
      "description": "Direct URL to paper PDF"
    },
    "code_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to code repository"
    },
    "code_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "Pinned git commit hash"
    },
    "code_platform": {
      "type": "string",
      "enum": ["github", "gitlab", "huggingface", "other"],
      "default": "github"
    },
    "domain": {
      "type": "string",
      "enum": ["vision", "nlp", "multimodal", "reinforcement-learning", "generative", "robotics", "graph", "audio", "tabular", "theory", "systems", "other"],
      "description": "Primary research domain"
    },
    "ground_truth_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/Claim" },
      "description": "Auto-extracted claims for evaluation scoring. NOT provided to agent."
    },
    "required_assets": {
      "$ref": "#/$defs/RequiredAssets",
      "description": "Datasets, model weights, and other heavy downloads required to reproduce this paper."
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty"
    },
    "repo_analysis": {
      "$ref": "#/$defs/RepoAnalysis",
      "description": "Auto-generated repository analysis (from PANDA's analyzeRepo)"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Free-form tags for filtering"
    },
    "notes": {
      "type": "string",
      "description": "Annotator notes (special requirements, known issues)"
    }
  },
  "$defs": {
    "Claim": {
      "type": "object",
      "required": ["claim_id", "description", "metric_name", "metric_value", "source_location"],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^c\\d+$",
          "description": "Claim identifier within this paper (c1, c2, ...)"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description (e.g., 'Table 1: CIFAR-10 test accuracy')"
        },
        "metric_name": {
          "type": "string",
          "description": "Metric name (accuracy, F1, BLEU, FID, mAP, etc.)"
        },
        "metric_value": {
          "type": "number",
          "description": "Paper-reported value"
        },
        "metric_unit": {
          "type": "string",
          "description": "Unit or scale (%, ratio_0_1, raw, dB, etc.)",
          "default": "%"
        },
        "source_location": {
          "type": "string",
          "description": "Where in the paper (Table 1, Figure 3, Section 4.2)"
        },
        "higher_is_better": {
          "type": "boolean",
          "description": "Whether higher values are better for this metric",
          "default": true
        },
        "tolerance": {
          "type": "number",
          "description": "Relative tolerance (0.05 = ±5%)",
          "default": 0.05,
          "minimum": 0.001,
          "maximum": 0.5
        },
        "claim_difficulty": {
          "type": "string",
          "enum": ["quick", "medium", "long", "prohibitive"],
          "description": "Estimated compute time to reproduce this claim"
        },
        "experiment_hint": {
          "type": "string",
          "description": "Optional hint about which script/command to run"
        },
        "dataset": {
          "type": "string",
          "description": "Dataset name used for this claim"
        },
        "category": {
          "type": "string",
          "enum": ["main", "ablation", "analysis", "baseline"],
          "description": "Claim category. 'baseline' claims are excluded from primary scoring.",
          "default": "main"
        }
      }
    },
    "RequiredAssets": {
      "type": "object",
      "description": "Manifest of heavyweight resources the reader must download to reproduce the paper.",
      "properties": {
        "datasets": {
          "type": "array",
          "items": { "$ref": "#/$defs/Asset" },
          "description": "Public datasets the paper trains/evaluates on."
        },
        "model_weights": {
          "type": "array",
          "items": { "$ref": "#/$defs/Asset" },
          "description": "Pretrained checkpoints loaded by the code."
        },
        "other_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/Asset" },
          "description": "Other large downloads (precomputed features, docker images, binary releases)."
        },
        "total_download_size_bytes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Sum of resolved size_bytes across all assets (excluding nulls)."
        },
        "total_download_size_human": {
          "type": "string",
          "description": "Human-readable form of total_download_size_bytes (e.g., '~180 GB')."
        },
        "extraction_method": {
          "type": "string",
          "enum": ["llm", "kb", "manual"],
          "description": "How this manifest was produced."
        },
        "extraction_model": {
          "type": "string",
          "description": "Model identifier used for LLM extraction (e.g., 'deep-deepseek-v4-pro')."
        },
        "extracted_at": {
          "type": "string",
          "description": "ISO 8601 UTC timestamp of extraction."
        },
        "fully_automatable": {
          "type": "boolean",
          "description": "True iff every asset's automation_status is 'automatable' or 'automatable_with_auth'. False if any asset is semi_automatable / manual_browser / manual_only / unreachable."
        },
        "manual_blockers": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of assets with manual_action_required=true (i.e., blocking a fully scripted reproduction)."
        }
      }
    },
    "Asset": {
      "type": "object",
      "required": ["name"],
      "description": "A single downloadable artifact (dataset, model checkpoint, or other heavy asset).",
      "properties": {
        "name": {
          "type": "string",
          "description": "Canonical name (e.g., 'ImageNet-1K (ILSVRC2012)', 'openai/clip-vit-large-patch14')."
        },
        "type": {
          "type": "string",
          "enum": ["dataset", "model_weights", "library", "precomputed_features", "binary", "docker_image", "other"],
          "description": "Asset category. Set on items in 'other_assets'; 'datasets' and 'model_weights' arrays default by container."
        },
        "purpose": {
          "type": "string",
          "description": "What this asset is used for in the paper (≤ 80 chars)."
        },
        "size_bytes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Best-known size in bytes; null if unknown."
        },
        "size_human": {
          "type": "string",
          "description": "Human-readable size (e.g., '~150 GB', '440 MB')."
        },
        "size_source": {
          "type": "string",
          "enum": ["kb", "hf_api", "hf_search", "extracted", "estimated", "unknown"],
          "description": "Where size_bytes came from. KB > HF API (explicit id) > HF search (guessed id) > paper text > LLM estimate > unknown."
        },
        "url": {
          "type": "string",
          "description": "Canonical download URL when known."
        },
        "huggingface_id": {
          "type": "string",
          "description": "HuggingFace repo id (e.g., 'meta-llama/Llama-2-7b-hf')."
        },
        "license": {
          "type": "string",
          "description": "License identifier or short note."
        },
        "required_for_claims": {
          "type": "array",
          "items": { "type": "string", "pattern": "^c\\d+$" },
          "description": "Claim ids (c1, c2, ...) this asset is needed for; empty if applies to whole paper."
        },
        "notes": {
          "type": "string",
          "description": "Free-form note (≤ 200 chars), e.g., access instructions or known caveats."
        },
        "availability": {
          "type": "string",
          "enum": ["public", "restricted", "paid", "private", "promised", "bundled", "unknown"],
          "description": "How the asset is offered to the world. 'public': anyone can download. 'restricted': public but requires registration/license/academic affiliation. 'paid': commercial. 'private': only authors have it. 'promised': paper says it will be released but isn't yet. 'bundled': ships in the repo. 'unknown': cannot be determined."
        },
        "access_pattern": {
          "type": "string",
          "description": "How the URL is fetched. See scripts/collect/access_patterns.json _enum_access_pattern for canonical values (huggingface_api, github_releases, uci_repository, sharepoint_anonymous, baidu_pan, google_drive, etc.)."
        },
        "automation_status": {
          "type": "string",
          "enum": ["automatable", "automatable_with_auth", "semi_automatable", "manual_browser", "manual_only", "unreachable", "unknown"],
          "description": "Whether the URL can be downloaded by a script. 'automatable': curl/HF/etc. works. 'automatable_with_auth': scriptable but needs API key (Kaggle). 'semi_automatable': scriptable but fragile (Drive, MEGA). 'manual_browser': needs a real browser session (SharePoint anonymous). 'manual_only': human action required (form, email, Baidu Pan)."
        },
        "auth_required": {
          "type": "string",
          "enum": ["none", "api_key", "login", "gated_license", "extraction_code", "browser_session", "human_request", "unknown"],
          "description": "What authentication the user must provide before download will succeed."
        },
        "manual_action_required": {
          "type": "boolean",
          "description": "True iff a human must intervene (browser/form/email/Baidu code). Mirrored into data/manual_action_queue.json for tracking."
        }
      }
    },
    "Difficulty": {
      "type": "object",
      "required": ["tier", "composite_score"],
      "properties": {
        "tier": {
          "type": "integer",
          "enum": [1, 2, 3, 4],
          "description": "Difficulty tier (1=Easy, 2=Medium, 3=Hard, 4=Expert)"
        },
        "composite_score": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 5.0,
          "description": "Weighted composite difficulty score (1.0-5.0)"
        },
        "dimensions": {
          "type": "object",
          "description": "Per-dimension scores (0.0-1.0 scale)",
          "properties": {
            "framework_complexity": { "type": "number", "minimum": 0, "maximum": 1 },
            "dependency_count": { "type": "number", "minimum": 0, "maximum": 1 },
            "dataset_requirements": { "type": "number", "minimum": 0, "maximum": 1 },
            "hardware_requirements": { "type": "number", "minimum": 0, "maximum": 1 },
            "code_quality": { "type": "number", "minimum": 0, "maximum": 1 },
            "reproduction_time": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "RepoAnalysis": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "enum": ["pytorch", "tensorflow", "jax", "keras", "mxnet", "unknown"]
        },
        "build_systems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "entry_points": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependency_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "python_version": {
          "type": "string"
        },
        "gpu_required": {
          "type": "boolean"
        },
        "python_loc": {
          "type": "integer",
          "description": "Lines of Python code"
        }
      }
    }
  }
}
